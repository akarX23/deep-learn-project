        "prompt": "What determines the fraction of the gradient subtracted from the parameters at each iteration of gradient descent?",
        "sub_concept": "Learning Rate",
        "max_points": 1,
        "options": [
          {
            "id": "q1a",
            "text": "The learning rate",
            "is_correct": true,
