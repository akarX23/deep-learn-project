# === Shared ===
APP_ENV=development
LOG_LEVEL=INFO

# === RAG Agent ===
# Provider defaults (used when env vars are unset): hosted_vllm
RAG_TEXT_PROVIDER=hosted_vllm
RAG_TEXT_MODEL=gpt-4o-mini
RAG_TEXT_API_BASE=http://localhost:8000/v1
RAG_TEXT_API_KEY=
RAG_TEXT_TEMPERATURE=0.2
RAG_TEXT_MAX_TOKENS=1800

RAG_VLM_PROVIDER=hosted_vllm
RAG_VLM_MODEL=gpt-4o-mini
RAG_VLM_API_BASE=http://localhost:8000/v1
RAG_VLM_API_KEY=
RAG_VLM_TEMPERATURE=0.1
RAG_VLM_MAX_TOKENS=600
RAG_VLM_BATCH_SIZE=4

RAG_EMBEDDING_PROVIDER=hosted_vllm
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_BASE=http://localhost:8000/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MAX_TOKENS=1024

RAG_PAGE_PARALLELISM=4

# === Planner Agent ===
# Add planner-specific variables here.
PLANNER_TEXT_MODEL=hosted_vllm/qwen/qwen3.5-9b
PLANNER_TEXT_API_BASE=http://localhost:8000/v1
PLANNER_TEXT_API_KEY=bdaks
PLANNER_TEXT_TEMPERATURE=1
PLANNER_TEXT_MAX_TOKENS=2000
PLANNER_LEVEL_CONFIDENCE_THRESHOLD=0.90
PLANNER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Orchestration Agent ===
PLANNER_LLM_MODEL=gpt-4o-mini
PLANNER_LLM_API_BASE=http://localhost:8000/v1
PLANNER_LLM_API_KEY=
PLANNER_LLM_TEMPERATURE=0.2
PLANNER_LLM_MAX_TOKENS=2048

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=planner-agent-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000
PLANNER_KAFKA_POLL_TIMEOUT_MS=1000

PLANNER_MAX_RETRIES=3
AGENT_RESPONSE_TIMEOUT_SEC=120
PLANNER_MIN_CONTENT_LENGTH=100
PLANNER_CLARIFICATION_TIMEOUT_SEC=120
PLANNER_LEVEL_CONFIDENCE_THRESHOLD=0.65
PLANNER_MAX_QUERY_LENGTH=2000

# === Teaching Agent ===
TEACHING_MODEL=groq/llama-3.3-70b-versatile
TEACHING_API_KEY=
TEACHING_TEMPERATURE=0.7

# Per-mode overrides (uncomment and set to use a different model/key/limit per learner level)
# Falls back to TEACHING_MODEL / TEACHING_API_KEY / 4096 / TEACHING_TEMPERATURE when unset.
# EFFORT only applies to Claude 4.6 models (Sonnet 4.6, Opus 4.6); silently skipped for others.
TEACHING_BEGINNER_MODEL=groq/llama-3.3-70b-versatile
TEACHING_BEGINNER_API_KEY=
TEACHING_BEGINNER_MAX_TOKENS=1024
TEACHING_BEGINNER_TEMPERATURE=0.7
# TEACHING_BEGINNER_EFFORT=low  # not applicable for Groq/Llama

TEACHING_INTERMEDIATE_MODEL=anthropic/claude-haiku-4-5-20251001
TEACHING_INTERMEDIATE_API_KEY=
TEACHING_INTERMEDIATE_MAX_TOKENS=2048
TEACHING_INTERMEDIATE_TEMPERATURE=0.5
# TEACHING_INTERMEDIATE_EFFORT=medium  # not applicable for Haiku

TEACHING_ADVANCED_MODEL=anthropic/claude-sonnet-4-6
TEACHING_ADVANCED_API_KEY=
TEACHING_ADVANCED_MAX_TOKENS=4096
TEACHING_ADVANCED_TEMPERATURE=0.3
TEACHING_ADVANCED_EFFORT=low
# === Quiz Agent ===
QUIZ_MODEL="claude-sonnet-4-6"
QUIZ_API_KEY= 
QUIZ_API_BASE=

# === Backend Service (Kafka) ===
BACKEND_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BACKEND_KAFKA_STARTUP_RETRY_COUNT=5
BACKEND_KAFKA_STARTUP_RETRY_TIMEOUT_SECONDS=2
BACKEND_KAFKA_CLIENT_ID=backend-service
BACKEND_KAFKA_POLL_TIMEOUT_MS=1000
UPLOAD_DIR=./uploads

# Optional for secured clusters:
# BACKEND_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# BACKEND_KAFKA_SASL_MECHANISM=PLAIN
# BACKEND_KAFKA_SASL_USERNAME=
# BACKEND_KAFKA_SASL_PASSWORD=
# BACKEND_KAFKA_SSL_CAFILE=

# === Docker Compose Local Stack ===
COMPOSE_KAFKA_PORT=9092
COMPOSE_KAFKA_UI_PORT=8080

# RAG worker startup notes:
# - RAG does not call backend topic APIs on startup.
# - Required topics must already be provisioned in Kafka.
